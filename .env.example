# Railway Postgres plugin injects DATABASE_URL automatically.
# Local fallback uses SQLite if unset.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/us_stock_agents

# Optional Redis (Railway Redis plugin)
REDIS_URL=

# Telegram Bot (Railway Telegram Bot Python template or @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduler
RUN_INTERVAL_MINUTES=30
MARKET_HOURS_ONLY=true
TIMEZONE=America/New_York

# Strategy evolution goals
PROFIT_TARGET_PCT=5.0
MAX_DRAWDOWN_PCT=10.0
CHAMPION_MIN_TRADES=5
INITIAL_CASH=100000

# Optional: protect POST /run (set same header in n8n)
API_KEY=

# Hermes Self-Improving Agent (Railway template) — strategy coach + memory
HERMES_ENABLED=false
HERMES_API_URL=https://your-hermes.up.railway.app
HERMES_API_KEY=
HERMES_MODEL=default
CONTINUE_UNTIL_PROFIT=true
HERMES_FLAT_BAND_PCT=1.0
